---
// Botón claro/oscuro. El tema inicial lo pone Layout.astro antes de pintar (sistema o lo elegido).
// Sin JavaScript queda oculto y manda el sistema.
---
<button class="tema" type="button" aria-label="Modo oscuro" aria-pressed="false" hidden>
  <svg class="luna" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5Z" /></svg>
  <svg class="sol" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
</button>

<script>
  const boton = document.querySelector<HTMLButtonElement>('.tema')!;
  const html = document.documentElement;
  const pintar = () => boton.setAttribute('aria-pressed', String(html.dataset.tema === 'oscuro'));
  pintar();
  boton.hidden = false;
  boton.addEventListener('click', () => {
    const tema = html.dataset.tema === 'oscuro' ? 'claro' : 'oscuro';
    (window as any).ponerTema(tema);
    try { localStorage.setItem('tema', tema); } catch {}
    pintar();
  });
  // Layout sigue al sistema si nunca se eligió; aquí solo se refleja en el botón.
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', pintar);
</script>

<style>
  .tema {
    flex: none; width: 44px; height: 44px; border: 0; border-radius: 999px; padding: 0;
    display: grid; place-items: center; background: var(--mosaico); color: var(--tinta); cursor: pointer;
    transition: transform .15s;
  }
  .tema:active { transform: scale(.94); }
  .tema[hidden] { display: none; }
  svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  /* Muestra a qué modo se cambia: luna en claro, sol en oscuro. */
  .luna { fill: currentColor; }
  [aria-pressed='true'] .luna, [aria-pressed='false'] .sol { display: none; }
  @media (prefers-reduced-motion: reduce) { .tema { transition: none; } }
</style>
