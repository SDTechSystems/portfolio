---
// Un juego: portada con la pestaña de consola, nombre, nota y precio. Tocarlo lo suma al pedido (Pedido.astro).
// Pestaña: logo de Switch (src/assets/switch.svg); en Switch 2, seguido de "2" y en cian.
// Juego con varias versiones (Switch 1, Switch 2, paquete de mejora): un solo mosaico con la pestaña doble y
// una fila por versión; cada fila es su propio botón con su precio y su "+".
// Mosaico normal con "N versiones · Switch 1 desde $ …" (la edición de ese precio); tocarlo abre el panel (PanelVersiones.astro), al que se
// mueven las filas. Igual en celular y escritorio, para que todos los mosaicos de una fila midan lo mismo.
// Hasta que el panel esté listo, las filas se ven en el mosaico. El destacado grande las muestra.
// Sin portada queda el fondo gris de .img. alt vacío: el nombre ya está escrito debajo.
import { Image } from 'astro:assets';
import LogoSwitch from '../assets/switch.svg';
import { precio, item, type Ficha } from '../lib/catalogo';
import { normalizar } from '../lib/buscar';
interface Props { f: Ficha; tamano?: 'grande' | 'medio' }
const { f, tamano } = Astro.props;
const [unica] = f.versiones;
const varias = f.versiones.length > 1;
const dos = !varias && unica.consola === 'Switch 2';
// Ancho real de la portada, para que el navegador baje la variante justa (medido de 320 a 2560px).
// Celular: 6 columnas, margen 10px y separación 10px → medio tablero = 50vw − 15px; todo = 100vw − 20px.
// Escritorio: 10 columnas, margen 12px y separación 12px → 2 col = 20vw − 14px; 5 col = 50vw − 18px;
// todo = 100vw − 24px. Desde 1440px el tablero no crece más (max-width en index.astro): anchos fijos.
// El grande es la portada de cine: ocupa todo el ancho y se recorta en alto, no en ancho.
const sizes = tamano === 'grande' ? '(min-width: 1440px) 1416px, (min-width: 760px) calc(100vw - 24px), calc(100vw - 20px)'
  : tamano === 'medio' ? '(min-width: 1440px) 702px, (min-width: 760px) calc(50vw - 18px), calc(50vw - 15px)'
  : '(min-width: 1440px) 274px, (min-width: 760px) calc(20vw - 14px), calc(50vw - 15px)';
// Escalones de 80–160px hasta 960 (celular: 390px a densidad 3 necesita 543px). Arriba, para escritorio
// y pantallas de densidad 2: el grande a 1440px necesita ~1900px. Las portadas originales miden 1920.
const ANCHOS = [320, 400, 480, 560, 640, 800, 960, 1120, 1280, 1600, 1920];
// Panel en todos los juegos con versiones salvo el destacado grande, que tiene sitio para las filas.
const panel = varias && tamano !== 'grande';
const Caja = varias ? 'div' : 'a';
// Qué parte de la portada se conserva al recortarla. Izquierda/derecha corren la ventana hacia ese lado
// (7 %/93 %); en la portada de cine el recorte es en alto, así que solo mueven el encuadre si la pantalla es angosta.
const RECORTE = { arriba: '50% 0%', centro: '50% 50%', abajo: '50% 100%', izquierda: '7% 50%', derecha: '93% 50%' };
---
<Caja class:list={['mosaico', tamano, { ancho: varias, panel }]} data-buscar={normalizar([...new Set([f.nombre, ...f.versiones.map((v) => v.nombre)])].join(' '))} {...(varias ? {} : item(unica))}>
  <div class="img">
    {varias
      ? <span class="consola doble" role="img" aria-label="Nintendo Switch 1 y Switch 2"><span><LogoSwitch /></span><span class="dos"><LogoSwitch /><b>2</b></span></span>
      : <span class:list={['consola', { dos }]} role="img" aria-label={`Nintendo ${unica.consola}`}><LogoSwitch />{dos && <b>2</b>}</span>}
    {f.imagen && (
      <Image
        src={f.imagen}
        alt=""
        style={f.recorte ? `object-position: ${RECORTE[f.recorte]}` : undefined}
        widths={ANCHOS.filter((w) => w <= f.imagen!.width)}
        sizes={sizes}
        format="webp"
        quality={78}
        loading={tamano ? 'eager' : 'lazy'}
        fetchpriority={tamano ? 'high' : undefined}
      />
    )}
  </div>
  <div class="pie">
    <span class="n">{f.nombre}</span>
    {f.nota && <span class="c">{f.nota}</span>}
    {panel && (
      <button type="button" class="abrir" aria-haspopup="dialog">
        <span class="solo-lector">{f.nombre}: </span>
        <span class="c">{f.versiones.length} versiones{f.desde && <> · <span class="junto">{f.desde.consola} desde</span></>}</span>
        <strong>{precio(f.desde?.precio ?? null)}</strong>
      </button>
    )}
    {varias
      ? (
        <div class="versiones">
          {f.versiones.map((v) => (
            <a class="version" {...item(v)}>
              <span class="solo-lector">{f.nombre}, </span>
              <span class="edicion">
              {/* Portada de cada edición junto a su precio; solo se ve en el panel (PanelVersiones.astro). */}
              {v.imagen && <Image class="mini" src={v.imagen} alt="" widths={[160, 320].filter((w) => w <= v.imagen!.width)} sizes="96px" format="webp" quality={78} loading="lazy" />}
              {v.tipo === 'Mejora'
                ? <span class="sello" role="img" aria-label="Paquete de mejora a Nintendo Switch 2">Mejora a <LogoSwitch /><b>2</b></span>
                : <span class:list={['sello', { dos: v.consola === 'Switch 2' }]} role="img" aria-label={`Nintendo ${v.consola}`}><LogoSwitch />{v.consola === 'Switch 2' && <b>2</b>}</span>}
              </span>
              <strong>{precio(v.precio)}</strong>
            </a>
          ))}
        </div>
      )
      : <strong>{precio(unica.precio)}</strong>}
  </div>
</Caja>

<style>
  .mosaico[hidden] { display: none; }
  .mosaico { --fondo: var(--mosaico); grid-column: span 3; display: flex; flex-direction: column; border-radius: 12px; overflow: hidden; background: var(--fondo); cursor: pointer; transition: transform .15s, background-color .15s; }
  .mosaico:active { transform: scale(.98); }
  .img { aspect-ratio: 16 / 9; background: var(--sin-portada); position: relative; overflow: hidden; }
  /* Vitrina: con ratón, la portada se acerca un poco al pasar por encima. */
  .img img { transition: transform .3s cubic-bezier(.2, .8, .2, 1); }
  @media (hover: hover) { .mosaico:hover .img img { transform: scale(1.04); } }
  /* Pestaña de consola: chip de vidrio que flota sobre la portada (8px del borde); Switch 1 en vidrio oscuro,
     Switch 2 en vidrio cian. */
  .consola {
    position: absolute; top: 8px; left: 8px; z-index: 1; height: 28px; padding: 0 10px; display: flex; align-items: center; gap: 3px;
    border-radius: 999px; background: var(--cristal); color: var(--sobre-cristal); font-size: 16px; line-height: 1;
    -webkit-backdrop-filter: var(--desenfoque); backdrop-filter: var(--desenfoque); box-shadow: var(--relieve);
  }
  .consola svg { width: 1em; height: 1em; }
  .consola b { font-weight: 800; letter-spacing: -.02em; }
  .consola.dos, .doble .dos { background: var(--acento-cristal); color: var(--sobre-acento); }
  /* Pestaña doble: Switch 1 en vidrio oscuro y Switch 2 en vidrio cian, en la misma píldora. */
  .consola.doble { padding: 0; gap: 0; overflow: hidden; }
  .doble > span { height: 100%; padding: 0 10px; display: flex; align-items: center; gap: 3px; }
  img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .pie { flex: 1; display: flex; flex-direction: column; gap: 2px; padding: 10px 12px 12px; }
  .n { font-size: 14px; font-weight: 800; line-height: 1.2; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .c { font-size: 13px; color: var(--suave); }
  .junto { white-space: nowrap; }
  /* DejaVu (tipografía de SD Tech) es más ancha: a 320px el precio baja a 17px para no chocar con el +/✓. */
  strong { margin-top: auto; padding-top: 6px; display: flex; justify-content: space-between; align-items: center; gap: 4px; font-size: clamp(17px, 5.4vw, 22px); font-weight: 800; letter-spacing: -.02em; }
  strong::after { flex: none; }

  /* "+" / "✓": dice que el mosaico se suma al pedido. Solo aparece si el script de Pedido lo activó. */
  [aria-pressed] strong::after { content: '+'; content: '+' / ''; width: 28px; height: 28px; border-radius: 50%; display: grid; place-items: center; background: var(--suelo); font-size: 20px; font-weight: 500; letter-spacing: 0; }
  /* Elegido: el mosaico se enciende en tinta (casi blanco) con texto oscuro y ✓ cian. */
  [aria-pressed='true'] { --fondo: var(--tinta); color: var(--suelo); }
  [aria-pressed='true'] .c { color: var(--suave-sel); }
  [aria-pressed='true'] strong::after { content: '✓'; content: '✓' / ''; background: var(--acento); color: var(--sobre-acento); font-size: 15px; }
  /* Sin precio ("Consultar"): el mosaico abre WhatsApp en vez de sumarse al pedido; la flecha lo distingue del "+". */
  [target] strong::after { content: '↗'; content: '↗' / ''; width: 28px; height: 28px; border-radius: 50%; display: grid; place-items: center; background: var(--suelo); font-size: 16px; font-weight: 500; letter-spacing: 0; }

  /* Juego con varias versiones: mosaico normal; el botón .abrir cubre todo el mosaico y abre el panel. */
  .ancho { position: relative; }
  /* Sin panel (destacado grande) el mosaico no es tocable: solo sus filas. */
  .ancho:not([data-panel-listo]) { cursor: auto; }
  .ancho:not([data-panel-listo]):active { transform: none; }
  .abrir { margin-top: auto; padding: 0; border: 0; background: none; color: inherit; font: inherit; text-align: left; display: none; flex-direction: column; gap: 2px; cursor: pointer; }
  .abrir::before { content: ''; position: absolute; inset: 0; z-index: 2; }
  .abrir:focus-visible { outline: none; }
  .ancho:has(.abrir:focus-visible) { outline: 3px solid var(--tinta); outline-offset: 2px; }
  .abrir strong::after { content: '+'; content: '+' / ''; width: 28px; height: 28px; border-radius: 50%; display: grid; place-items: center; background: var(--suelo); font-size: 20px; font-weight: 500; letter-spacing: 0; }
  /* Con alguna versión elegida, el mosaico se ve elegido (sus filas no están a la vista). */
  .panel[data-panel-listo]:has(.version[aria-pressed='true']) { --fondo: var(--tinta); color: var(--suelo); }
  .panel[data-panel-listo]:has(.version[aria-pressed='true']) .c { color: var(--suave-sel); }
  /* El ✓ lleva texto para el lector de pantalla: las filas con aria-pressed están ocultas en el panel. */
  .panel[data-panel-listo]:has(.version[aria-pressed='true']) .abrir strong::after { content: '✓'; content: '✓' / 'versión elegida'; background: var(--acento); color: var(--sobre-acento); font-size: 15px; }
  .panel[data-panel-listo] .abrir { display: flex; }
  .panel[data-panel-listo] .versiones { display: none; }
  /* Respaldo por defecto, también si falla el script con JavaScript habilitado. */
  .panel:not([data-panel-listo]) { grid-column: span 6; }
  .panel:not([data-panel-listo]) .img { aspect-ratio: 3 / 1; }
  /* Las portadas de Switch 2 Edition suelen llevar la franja "Nintendo Switch 2 Edition" abajo: si la portada
     se recorta (destacados, sin JavaScript), se conserva. Si está en otro lugar, productos.json → imagen.recorte. */
  .ancho img { object-position: 50% 100%; }
  /* Retícula común (subgrid): sellos en una columna a la izquierda y precios alineados a la derecha,
     junto al "+", para compararlos como en una lista de precios. */
  .versiones { margin-top: auto; padding-top: 6px; display: grid; grid-template-columns: auto 1fr; gap: 4px 10px; }
  .version { --fondo: var(--mosaico); min-height: 44px; margin: 0 -6px; padding: 4px 6px; border-radius: 6px; grid-column: 1 / -1; display: grid; grid-template-columns: subgrid; align-items: center; background: var(--fondo); cursor: pointer; transition: transform .15s, background-color .15s; }
  .version:active { transform: scale(.98); }
  .version[aria-pressed='true'] { --fondo: var(--tinta); color: var(--suelo); }
  .version[aria-pressed='true'] strong::after { color: var(--sobre-acento); }
  .version strong { margin: 0; padding: 0; justify-content: flex-end; gap: 10px; }
  /* Sello de cada versión: como la pestaña, en pequeño (Switch 2 en cian). */
  .edicion { justify-self: start; position: relative; }
  .sello { height: 28px; padding: 0 8px; border-radius: 6px; display: flex; align-items: center; gap: 3px; background: var(--suelo); color: var(--tinta); font-size: 13px; font-weight: 800; line-height: 1; }
  .sello svg { width: 17px; height: 17px; }
  .sello b { font-size: 17px; font-weight: 800; letter-spacing: -.02em; }
  .sello.dos { background: var(--acento-cristal); color: var(--sobre-acento); }
  /* En el panel (vidrio) las filas no elegidas son transparentes y los sellos, vidrio. */
  :global(.hoja) .version:not([aria-pressed='true']) { --fondo: transparent; }
  :global(.hoja) .sello:not(.dos) { background: color-mix(in srgb, var(--suelo) 55%, transparent); }
  /* En el panel, cada edición lleva su portada con el sello en la esquina, como la pestaña del mosaico. */
  .mini { display: none; }
  :global(.hoja) .mini { display: block; position: static; width: 96px; height: auto; aspect-ratio: 16 / 9; border-radius: 6px; }
  :global(.hoja) .mini + .sello {
    position: absolute; top: 4px; left: 4px; height: 22px; padding: 0 6px; border-radius: 999px;
    -webkit-backdrop-filter: var(--desenfoque); backdrop-filter: var(--desenfoque); box-shadow: var(--relieve);
  }
  :global(.hoja) .mini + .sello:not(.dos) { background: var(--cristal); color: var(--sobre-cristal); }
  .solo-lector { position: absolute; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  /* Portada de cine: el destacado ocupa todo el ancho y su pie es un panel de vidrio que se monta sobre la
     parte baja de la portada (celular) o flota abajo a la izquierda (escritorio). Sin degradado. */
  .grande { grid-column: 1 / -1; position: relative; }
  .grande .img { aspect-ratio: 16 / 9; }
  .grande .pie {
    position: relative; z-index: 1; margin: -44px 10px 10px; border-radius: 14px; padding: 14px 16px 16px;
    background: color-mix(in srgb, var(--fondo) 60%, transparent); transition: background-color .15s;
    -webkit-backdrop-filter: var(--desenfoque); backdrop-filter: var(--desenfoque); box-shadow: var(--relieve), 0 8px 24px var(--sombra);
  }
  .grande strong::after { background: color-mix(in srgb, var(--suelo) 55%, transparent); }
  .grande[aria-pressed='true'] strong::after { background: var(--acento-cristal); }
  /* Sin vidrio (navegadores viejos): vuelven los colores sólidos para que todo se lea. */
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .consola, :global(.hoja) .mini + .sello:not(.dos) { background: var(--tinta); color: var(--suelo); }
    .consola.dos, .doble .dos, .sello.dos { background: var(--acento); }
    .grande .pie { background: var(--fondo); }
  }
  .grande .n { font-size: 18px; font-weight: 800; }
  .grande strong { font-size: 30px; }

  @media (min-width: 760px) {
    .mosaico { grid-column: span 2; }
    .panel:not([data-panel-listo]) { grid-column: span 4; }
    .grande { grid-column: 1 / -1; }
    /* 21:9 como pantalla de cine; se acorta para que, bajo la cabecera, asome la fila de los otros destacados. */
    .grande .img { aspect-ratio: 21 / 9; max-height: max(360px, calc(100svh - 280px)); }
    .grande .pie { position: absolute; left: 16px; bottom: 16px; width: min(440px, 45%); margin: 0; }
    .medio { grid-column: span 5; }
    .medio.panel:not([data-panel-listo]) { grid-column: span 5; }
    .medio .img { aspect-ratio: 2.1 / 1; }
  }
  @media (prefers-reduced-motion: reduce) { .mosaico, .version, .img img, .grande .pie { transition: none; } .mosaico:hover .img img { transform: none; } }
</style>
