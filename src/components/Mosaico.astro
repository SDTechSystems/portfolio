---
// Un juego: portada con la pestaña de consola, nombre, nota y precio. Tocarlo lo suma al pedido (Pedido.astro).
// Pestaña: logo de Switch (src/assets/switch.svg); en Switch 2, seguido de "2" y en rojo.
// Juego con varias versiones (Switch 1, Switch 2, paquete de mejora): un solo mosaico con la pestaña doble y
// una fila por versión; cada fila es su propio botón con su precio y su "+".
// · Celular: mosaico normal con "N versiones · desde $ …"; tocarlo abre el panel (PanelVersiones.astro),
//   al que se mueven las filas. Sin JavaScript (<noscript> en index.astro) las filas se ven en el mosaico.
// · Escritorio (≥ 760px): mosaico ancho con las filas a la vista.
// Sin portada queda el fondo gris de .img. alt vacío: el nombre ya está escrito debajo.
import { Image } from 'astro:assets';
import LogoSwitch from '../assets/switch.svg';
import { precio, item, type Ficha } from '../lib/catalogo';
interface Props { f: Ficha; tamano?: 'grande' | 'medio' }
const { f, tamano } = Astro.props;
const [unica] = f.versiones;
const varias = f.versiones.length > 1;
const dos = !varias && unica.consola === 'Switch 2';
// Ancho real de la portada, para que el navegador baje la variante justa (medido de 320 a 1920px).
// Celular: 6 columnas, margen 10px y separación 8px → medio tablero = 50vw − 14px.
// Escritorio: 10 columnas, margen 12px y separación 8px → 2 col = 20vw − 11px; 4 col = 40vw − 14px;
// 6 col = 60vw − 18px. Desde 1100px la portada de .ancho es el 45 % de 4 columnas.
const sizes = tamano === 'grande' ? '(min-width: 760px) calc(60vw - 18px), calc(100vw - 20px)'
  : varias ? '(min-width: 1100px) calc(18vw - 6px), (min-width: 760px) calc(40vw - 14px), calc(50vw - 14px)'
  : tamano === 'medio' ? '(min-width: 760px) calc(40vw - 14px), calc(50vw - 14px)'
  : '(min-width: 760px) calc(20vw - 11px), calc(50vw - 14px)';
// Escalones de 80–160px: un celular de 390px y densidad 3 necesita 543px; con 320/480/640/960 bajaba 640.
const ANCHOS = [320, 400, 480, 560, 640, 800, 960];
// Panel solo en mosaicos de medio ancho en celular; el grande tiene sitio para las filas.
const panel = varias && tamano !== 'grande';
// "desde": el juego más barato (el paquete de mejora no cuenta: solo sirve a quien ya tiene el juego).
const juegos = f.versiones.filter((v) => v.tipo !== 'Mejora' && v.precio !== null).map((v) => v.precio!);
const desde = juegos.length ? Math.min(...juegos) : null;
const Caja = varias ? 'div' : 'a';
---
<Caja class:list={['mosaico', tamano, { ancho: varias, panel }]} {...(varias ? {} : item(unica))}>
  <div class="img">
    {varias
      ? <span class="consola doble" role="img" aria-label="Nintendo Switch 1 y Switch 2"><span><LogoSwitch /></span><span class="dos"><LogoSwitch /><b>2</b></span></span>
      : <span class:list={['consola', { dos }]} role="img" aria-label={`Nintendo ${unica.consola}`}><LogoSwitch />{dos && <b>2</b>}</span>}
    {f.imagen && (
      <Image
        src={f.imagen}
        alt=""
        style={f.recorte ? `object-position: 50% ${{ arriba: '0%', centro: '50%', abajo: '100%' }[f.recorte]}` : undefined}
        widths={ANCHOS.filter((w) => w <= f.imagen!.width)}
        sizes={sizes}
        format="webp"
        quality={78}
        loading={tamano ? 'eager' : 'lazy'}
        fetchpriority={tamano ? 'high' : undefined}
      />
    )}
  </div>
  <div class="pie">
    <span class="n">{f.nombre}</span>
    {f.nota && <span class="c">{f.nota}</span>}
    {panel && (
      <button type="button" class="abrir" aria-haspopup="dialog">
        <span class="solo-lector">{f.nombre}: </span>
        <span class="c">{f.versiones.length} versiones{desde !== null && ' · desde'}</span>
        <strong>{precio(desde)}</strong>
      </button>
    )}
    {varias
      ? (
        <div class="versiones">
          {f.versiones.map((v) => (
            <a class="version" {...item(v)}>
              <span class="solo-lector">{f.nombre}, </span>
              {v.tipo === 'Mejora'
                ? <span class="sello" role="img" aria-label="Paquete de mejora a Nintendo Switch 2">Mejora a <LogoSwitch /><b>2</b></span>
                : <span class:list={['sello', { dos: v.consola === 'Switch 2' }]} role="img" aria-label={`Nintendo ${v.consola}`}><LogoSwitch />{v.consola === 'Switch 2' && <b>2</b>}</span>}
              <strong>{precio(v.precio)}</strong>
            </a>
          ))}
        </div>
      )
      : <strong>{precio(unica.precio)}</strong>}
  </div>
</Caja>

<style>
  .mosaico { --fondo: var(--mosaico); grid-column: span 3; display: flex; flex-direction: column; border-radius: 8px; overflow: hidden; background: var(--fondo); cursor: pointer; transition: transform .15s, background-color .15s; }
  .mosaico:active { transform: scale(.98); }
  .img { aspect-ratio: 16 / 9; background: #d6d6dc; position: relative; }
  /* Pestaña de consola: esquina sólida pegada al borde; Switch 1 del color del mosaico, Switch 2 en rojo. */
  .consola { position: absolute; top: 0; left: 0; z-index: 1; height: 32px; padding: 0 9px; display: flex; align-items: center; gap: 3px; border-radius: 0 0 8px 0; background: var(--fondo); font-size: 17px; line-height: 1; transition: background-color .15s; }
  .consola svg { width: 1em; height: 1em; }
  .consola b { font-weight: 800; letter-spacing: -.02em; }
  .consola.dos, .doble .dos { background: var(--rojo); color: #fff; }
  /* Pestaña doble: Switch 1 del color del mosaico y Switch 2 en rojo, pegadas. */
  .consola.doble { padding: 0; gap: 0; overflow: hidden; }
  .doble > span { height: 100%; padding: 0 9px; display: flex; align-items: center; gap: 3px; }
  img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .pie { flex: 1; display: flex; flex-direction: column; gap: 2px; padding: 10px 12px 12px; }
  .n { font-size: 14px; font-weight: 800; line-height: 1.2; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .c { font-size: 13px; color: var(--suave); }
  strong { margin-top: auto; padding-top: 6px; display: flex; justify-content: space-between; align-items: center; font-size: 22px; font-weight: 800; letter-spacing: -.02em; }

  /* "+" / "✓": dice que el mosaico se suma al pedido. Solo aparece si el script de Pedido lo activó. */
  [aria-pressed] strong::after { content: '+'; content: '+' / ''; width: 28px; height: 28px; border-radius: 50%; display: grid; place-items: center; background: var(--suelo); font-size: 20px; font-weight: 500; letter-spacing: 0; }
  [aria-pressed='true'] { --fondo: var(--tinta); color: #fff; }
  [aria-pressed='true'] .c { color: #b9b9c2; }
  [aria-pressed='true'] strong::after { content: '✓'; content: '✓' / ''; background: var(--rojo); font-size: 15px; }
  /* Sin precio ("Consultar"): el mosaico abre WhatsApp en vez de sumarse al pedido; la flecha lo distingue del "+". */
  [target] strong::after { content: '↗'; content: '↗' / ''; width: 28px; height: 28px; border-radius: 50%; display: grid; place-items: center; background: var(--suelo); font-size: 16px; font-weight: 500; letter-spacing: 0; }

  /* Juego con varias versiones. Celular: mosaico normal; el botón .abrir cubre todo el mosaico y abre el panel. */
  .ancho { position: relative; }
  /* Sin panel (destacado grande) el mosaico no es tocable: solo sus filas. */
  .ancho:not(.panel) { cursor: auto; }
  .ancho:not(.panel):active { transform: none; }
  .abrir { margin-top: auto; padding: 0; border: 0; background: none; color: inherit; font: inherit; text-align: left; display: flex; flex-direction: column; gap: 2px; cursor: pointer; }
  .abrir::before { content: ''; position: absolute; inset: 0; z-index: 2; }
  .abrir:focus-visible { outline: none; }
  .ancho:has(.abrir:focus-visible) { outline: 3px solid var(--tinta); outline-offset: 2px; }
  .abrir strong::after { content: '+'; content: '+' / ''; width: 28px; height: 28px; border-radius: 50%; display: grid; place-items: center; background: var(--suelo); font-size: 20px; font-weight: 500; letter-spacing: 0; }
  /* Celular: con alguna versión elegida, el mosaico se ve elegido (sus filas no están a la vista). */
  @media (max-width: 759px) {
    .panel:has(.version[aria-pressed='true']) { --fondo: var(--tinta); color: #fff; }
    .panel:has(.version[aria-pressed='true']) .c { color: #b9b9c2; }
    /* El ✓ lleva texto para el lector de pantalla: las filas con aria-pressed están ocultas en el panel. */
    .panel:has(.version[aria-pressed='true']) .abrir strong::after { content: '✓'; content: '✓' / 'versión elegida'; background: var(--rojo); font-size: 15px; }
  }
  .panel .versiones { display: none; }
  /* Las portadas de Switch 2 Edition suelen llevar la franja "Nintendo Switch 2 Edition" abajo: el recorte 3:1
     de escritorio la conserva. Si está en otro lugar, productos.json → imagen.recorte lo cambia con style. */
  .ancho img { object-position: 50% 100%; }
  /* Retícula común (subgrid): sellos en una columna a la izquierda y precios alineados a la derecha,
     junto al "+", para compararlos como en una lista de precios. */
  .versiones { margin-top: auto; padding-top: 6px; display: grid; grid-template-columns: auto 1fr; gap: 4px 10px; }
  .version { --fondo: var(--mosaico); min-height: 44px; margin: 0 -6px; padding: 4px 6px; border-radius: 6px; grid-column: 1 / -1; display: grid; grid-template-columns: subgrid; align-items: center; background: var(--fondo); cursor: pointer; transition: transform .15s, background-color .15s; }
  .version:active { transform: scale(.98); }
  .version[aria-pressed='true'] { --fondo: var(--tinta); }
  .version strong { margin: 0; padding: 0; justify-content: flex-end; gap: 10px; }
  /* Sello de cada versión: como la pestaña, en pequeño (Switch 2 en rojo). */
  .sello { justify-self: start; height: 28px; padding: 0 8px; border-radius: 6px; display: flex; align-items: center; gap: 3px; background: var(--suelo); color: var(--tinta); font-size: 13px; font-weight: 800; line-height: 1; }
  .sello svg { width: 17px; height: 17px; }
  .sello b { font-size: 17px; font-weight: 800; letter-spacing: -.02em; }
  .sello.dos { background: var(--rojo); color: #fff; }
  .solo-lector { position: absolute; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  .grande { grid-column: span 6; }
  .grande .img { aspect-ratio: 2 / 1; }
  .grande .pie { padding: 14px 16px 16px; }
  .grande .n { font-size: 18px; font-weight: 800; }
  .grande strong { font-size: 30px; }

  @media (min-width: 760px) {
    .mosaico { grid-column: span 2; }
    .ancho { grid-column: span 4; cursor: auto; }
    .ancho:active { transform: none; }
    .abrir { display: none; }
    .panel .versiones { display: grid; }
    .ancho .img { aspect-ratio: 3 / 1; }
    .grande { grid-column: span 6; grid-row: span 2; }
    .grande .img { aspect-ratio: auto; flex: 1; }
    .grande .pie { flex: none; }
    .medio { grid-column: span 4; }
    /* Los 3 destacados caben con su precio en la primera pantalla (el grande mide lo que los dos chicos).
       182px = cabecera (183) + 3 separaciones de 8 + 2 pies de 75 + margen de 12, repartido entre 2 filas. */
    .medio .img { aspect-ratio: 2.1 / 1; max-height: max(140px, calc(50svh - 182px)); }
  }
  /* Juego con varias versiones en escritorio ancho: portada a la izquierda y versiones a la derecha,
     así mide lo mismo que los mosaicos de su fila y no los estira. Abajo de 1100px las filas no caben al lado. */
  @media (min-width: 1100px) {
    .ancho:not(.grande) { flex-direction: row; }
    .ancho:not(.grande) .img { flex: 0 0 45%; aspect-ratio: auto; max-height: none; }
    /* Destacado chico con versiones: alto mínimo según la pantalla, para que el grande (que mide lo que los
       dos chicos) no recorte su portada; 140px = cabecera (183) + separaciones, repartido entre 2 filas. */
    .medio.ancho { min-height: max(190px, calc(50svh - 140px)); }
  }
  @media (prefers-reduced-motion: reduce) { .mosaico, .consola, .version { transition: none; } }
</style>
