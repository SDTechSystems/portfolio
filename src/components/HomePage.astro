---
import SiteLayout from './SiteLayout.astro';
import LanguageSwitch from './LanguageSwitch.astro';
import Brand from './Brand.astro';
import TerminalTitle from './TerminalTitle.astro';
import WhatsAppIcon from './WhatsAppIcon.astro';
import { categories, assignments, siteConfig, interactiveDemos, demoLabel, waLink, waMessages, formatUpdated, type Locale } from '../data/catalog';
import { forms } from '../data/forms';
import BrandCard from './BrandCard.astro';
import { brands, featuredBrands } from '../data/brands';
import '../styles/brands.css';
import { getProjects, words } from '../i18n';
const { locale='es' }=Astro.props as {locale:Locale};
const t=words[locale], projects=getProjects(locale), base=import.meta.env.BASE_URL, es=locale==='es';
const formHref=(slug:string)=>`${base}es/formularios/${slug}/`;
const formsEn:Record<string,{name:string;card:string}>={
  'diseno-de-marca':{name:'Brand design',card:'Logo, palette, typefaces, social media pieces and corporate identity. Tell us about your business and we prepare 2 proposals.'},
  'pagina-web':{name:'Website',card:'Landing page, business site, online store or bookings. We help you define the website you need.'},
  'software-a-medida':{name:'Custom software',card:'Inventory, sales, appointments, orders or quotes. We assess your process and propose a system.'},
};
const formName=(f:typeof forms[number])=>es?f.name:formsEn[f.slug].name;
---
<SiteLayout locale={locale} title={`${siteConfig.name} — ${t.tagline} ${t.tagline2}`} description={t.intro}>
  <header class="site-header wrap"><Brand href={`${base}${locale}/`}/><nav class="main-navigation" aria-label={es?'Navegación principal':'Main navigation'}><a href="#proyectos">{t.projects} <span>{projects.length.toString().padStart(2,'0')}</span></a><a href={`${base}${locale}/marcas/`}>{es?'Marcas':'Brands'} <span>{brands.length}</span></a><details class="nav-quotes"><summary>{es?'Cotizar':'Get a quote'} <span aria-hidden="true">▾</span></summary><div class="nav-quotes-menu"><p>{es?'Formularios de cotización':'Quote forms'}{!es&&<small> · in Spanish</small>}</p>{forms.map((f,i)=><a href={formHref(f.slug)} style={`--i:${i}`}><span class="nav-quotes-num">{String(i+1).padStart(2,'0')}</span><span>{formName(f)}<small>≈ {f.minutes} min</small></span><span aria-hidden="true">↗</span></a>)}<a class="nav-quotes-wa" href={waLink(waMessages.quotes[locale])} target="_blank" rel="noopener noreferrer" style="--i:3"><WhatsAppIcon/><span>{es?'Prefiero escribir por WhatsApp':'I’d rather use WhatsApp'}</span></a></div></details><a href="#sobre-mi">{t.about}</a><a class="nav-contact" href="#contacto">{t.contact} ↗</a></nav><LanguageSwitch locale={locale}/></header>
  <main id="contenido">
    <section class="hero wrap" aria-labelledby="titulo"><div class="hero-top"><p class="eyebrow"><span class="terminal-cursor" aria-hidden="true">&gt;_</span>{t.heroLabel}</p><p class="hero-index">{t.portfolio}<br/>2025 — 2026</p></div><TerminalTitle first={t.tagline} second={t.tagline2}/><div class="hero-bottom"><p>{t.intro}</p><a class="round-link" href="#proyectos"><span>{t.explore}</span><span class="circle" aria-hidden="true">↓</span></a></div><div class="hero-line"><span>{t.ai}</span><span aria-hidden="true">/</span><span>{t.management}</span><span aria-hidden="true">/</span><span>{t.web}</span><span class="line-end">{t.design}</span></div></section>
    <section id="proyectos" class="projects-section wrap" aria-labelledby="proyectos-titulo">
      <div class="section-heading"><div><p class="eyebrow">{t.selected}</p><h2 id="proyectos-titulo">{t.concept}<br/>{t.interface}<span>.</span></h2></div><div class="section-heading-side"><p>{t.selection}</p><a class="wa-pill" href={waLink(waMessages.projects[locale])} target="_blank" rel="noopener noreferrer"><WhatsAppIcon/>{es?'¿Cuál se adapta a tu negocio? Pregúntame':'Which one fits your business? Ask me'}</a></div></div>
      <div class="filter-bar"><div class="filters" role="group" aria-label={t.filter}><button data-filter="all" aria-pressed="true">{t.all} <span>{projects.length}</span></button>{categories.filter(c=>c.visible).map(c=><button data-filter={c.id} aria-pressed="false">{c.label[locale]} <span>{projects.filter(p=>assignments[p.id]?.includes(c.id)).length}</span></button>)}</div><span class="filter-count" role="status" aria-live="polite" data-plural={t.count} data-singular={t.one}>{projects.length} {t.count}</span></div>
      <p id="catalog-empty" class="catalog-empty" hidden>{t.empty} <a href={`mailto:${siteConfig.email}`}>{t.contact} ↗</a></p>
      <div class="project-grid">{projects.map((p,i)=><article class="project-card" data-categories={(assignments[p.id]||[]).join(' ')}>
        <a class="project-visual" href={`${base}${locale}/${interactiveDemos[p.id]||`proyectos/${p.id}/`}`} aria-label={`${interactiveDemos[p.id]?demoLabel(p.id,locale):t.view} ${p.name}`}><div class="visual-top"><span>{String(i+1).padStart(2,'0')} / {p.category}</span><span>{interactiveDemos[p.id]?(locale==='es'?'↗ DEMO INTERACTIVA':'↗ INTERACTIVE DEMO'):p.private?`↳ ${t.private}`:`↗ ${t.public}`}</span></div><div class="screenshot-frame"><div class="browser-dots" aria-hidden="true"><i></i><i></i><i></i><span>{p.name}</span></div><img src={`${base}screenshots/${p.image}`} alt={`${locale==='es'?'Interfaz de':'Interface of'} ${p.name}`} width="1440" height="900" loading={i<2?'eager':'lazy'}/></div><span class="visual-arrow" aria-hidden="true">↗</span></a>
        <div class="card-heading"><h3><a href={`${base}${locale}/proyectos/${p.id}/`}>{p.name}</a></h3><span class:list={['status',['Alfa','Prototipo','Alpha','Prototype'].includes(p.status)?'status-amber':'']}><i></i>{p.status}</span></div><p class="card-title">{p.title}</p><div class="card-meta"><span>{p.stack.slice(0,3).join(' / ')}</span><span title={es?'Última actualización':'Last update'}>{p.version} · {es?'Act.':'Upd.'} {formatUpdated(p.updated,locale)}</span></div><div class="card-links">{interactiveDemos[p.id]&&<a class="demo-card-link" href={`${base}${locale}/${interactiveDemos[p.id]}`}>{demoLabel(p.id,locale)} ↗</a>}<a class="wa-link" href={waLink(waMessages.project(p.name,locale))} target="_blank" rel="noopener noreferrer"><WhatsAppIcon/>{es?'Me interesa':'I’m interested'}</a></div>
      </article>)}</div>
    </section>
    <section id="marcas" class="brands-teaser wrap" aria-labelledby="marcas-titulo">
      <div class="section-heading"><div><p class="eyebrow">{es?'02 / DISEÑO DE MARCA E IMAGEN CORPORATIVA':'02 / BRAND DESIGN AND CORPORATE IDENTITY'}</p><h2 id="marcas-titulo">{es?'Marcas que se':'Brands people'}<br/>{es?'ven y se recuerdan':'see and remember'}<span>.</span></h2></div><div class="section-heading-side"><p>{es?`${brands.length} identidades de ejemplo con logo, paleta, tipografías, redes, papelería y productos. Elige la que más se parezca a tu negocio y partimos de ahí.`:`${brands.length} sample identities with logo, palette, typefaces, social media, stationery and products. Pick the one closest to your business and we start from there.`}</p><a class="wa-pill" href={waLink(waMessages.brands[locale])} target="_blank" rel="noopener noreferrer"><WhatsAppIcon/>{es?'¿Te gustó alguna? Escríbeme':'Like one? Message me'}</a></div></div>
      <div class="brand-grid">{featuredBrands.map(b=><BrandCard brand={b} locale={locale}/>)}</div>
      <div class="brands-more"><a class="brand-btn" href={`${base}${locale}/marcas/`}>{es?`Ver las ${brands.length} marcas`:`See all ${brands.length} brands`} →</a><a class="brand-btn" href={formHref('diseno-de-marca')}>{es?'Cotizar mi marca':'Quote my brand'}{!es&&<small> · ES</small>} ↗</a></div>
    </section>
    <section id="sobre-mi" class="about-section"><div class="wrap about-grid"><div><p class="eyebrow">03 / SD TECH SYSTEMS</p><h2>{t.behind}<span>.</span></h2><Brand decorative/><p class="brand-family">{t.part}</p></div><div class="about-copy"><p class="about-lead">{t.bio}</p><p>{t.brand}</p><p>{t.story}</p><div class="about-tags">{t.values.map(v=><span>{v}</span>)}</div></div></div></section>
    <section id="cotizar" class="quotes-section wrap" aria-labelledby="cotizar-titulo">
      <div class="section-heading"><div><p class="eyebrow">{es?'04 / COTIZA TU PROYECTO':'04 / GET A QUOTE'}</p><h2 id="cotizar-titulo">{es?'Cuéntame qué':'Tell me what'}<br/>{es?'necesitas':'you need'}<span>.</span></h2></div><p>{es?'Elige el servicio y responde unas preguntas cortas. Con tus respuestas preparo una propuesta y una cotización personalizada.':'Choose a service and answer a few short questions. Your answers help me prepare a tailored proposal and quote. The forms are in Spanish.'}</p></div>
      <div class="quote-grid">{forms.map((f,i)=><a class="quote-card" href={formHref(f.slug)} style={`--i:${i}`}><span class="quote-num">{String(i+1).padStart(2,'0')}</span><h3>{formName(f)}</h3><p>{es?f.card:formsEn[f.slug].card}</p><span class="quote-meta"><span>{f.sections.reduce((n,s)=>n+s.questions.length,0)} {es?'preguntas':'questions'} · ≈ {f.minutes} min</span><span class="quote-go" aria-hidden="true">↗</span></span></a>)}</div>
    </section>
    <section id="contacto" class="contact-section wrap"><p class="eyebrow">{es?'05 / CONECTEMOS':'05 / LET’S CONNECT'}</p><div class="collaboration-copy"><h3>{t.collaborationTitle}</h3><p>{t.collaboration}</p></div><div class="contact-heading"><h2>{t.idea}<br/><em>{t.idea2}</em></h2><a href={waLink(waMessages.contact[locale])} class="contact-arrow contact-arrow-wa" target="_blank" rel="noopener noreferrer" aria-label={es?'Escribir por WhatsApp':'Message on WhatsApp'}><WhatsAppIcon/></a></div><div class="contact-links"><a class="contact-wa" href={waLink(waMessages.contact[locale])} target="_blank" rel="noopener noreferrer"><WhatsAppIcon/>WhatsApp · 305 814 7293 ↗</a><a href={`mailto:${siteConfig.email}`}>{siteConfig.email} ↗</a><a href={siteConfig.github} target="_blank" rel="noopener noreferrer">GitHub / SDTechSystems ↗</a></div></section>
    <a class="wa-float" href={waLink(waMessages.portfolio[locale])} target="_blank" rel="noopener noreferrer" aria-label={es?'Escribir por WhatsApp sobre el portafolio':'Message on WhatsApp about the portfolio'}><WhatsAppIcon/><span>{es?'Hablemos':'Let’s talk'}</span></a>
  </main>
<script>
 const buttons=document.querySelectorAll<HTMLButtonElement>('[data-filter]');
 buttons.forEach(button=>button.addEventListener('click',()=>{
   buttons.forEach(b=>b.setAttribute('aria-pressed',String(b===button)));
   let count=0;
   document.querySelectorAll<HTMLElement>('.project-card').forEach(card=>{
     card.hidden=button.dataset.filter!=='all'&&!card.dataset.categories?.split(' ').includes(button.dataset.filter!);
     if(!card.hidden)count++;
   });
   const label=document.querySelector<HTMLElement>('.filter-count');
   if(label)label.textContent=`${count} ${count===1?label.dataset.singular:label.dataset.plural}`;
   document.querySelector<HTMLElement>('#catalog-empty')!.hidden=count!==0;
 }));
 // Close the quotes menu on outside click or Escape.
 const quotes=document.querySelector<HTMLDetailsElement>('.nav-quotes');
 document.addEventListener('click',e=>{if(quotes?.open&&!quotes.contains(e.target as Node))quotes.open=false});
 document.addEventListener('keydown',e=>{if(e.key==='Escape'&&quotes?.open){quotes.open=false;quotes.querySelector('summary')?.focus()}});
</script>
</SiteLayout>
