---
import SiteLayout from './SiteLayout.astro';
import LanguageSwitch from './LanguageSwitch.astro';
import Brand from './Brand.astro';
import BrandCard from './BrandCard.astro';
import WhatsAppIcon from './WhatsAppIcon.astro';
import { brands, brandStyles, packageItems, corporateItems } from '../data/brands';
import { waLink, waMessages, type Locale } from '../data/catalog';
import '../styles/brands.css';
const { locale } = Astro.props as { locale: Locale };
const base = import.meta.env.BASE_URL, es = locale === 'es';
const form = `${base}es/formularios/diseno-de-marca/`;
const wa = waLink(waMessages.brands[locale]);
const title = es ? 'Diseño de marca e imagen corporativa' : 'Brand design and corporate identity';
const description = es
  ? `${brands.length} marcas de ejemplo con logos, paletas, tipografías, piezas para redes, papelería y aplicaciones en productos.`
  : `${brands.length} sample brands with logos, palettes, typefaces, social media pieces, stationery and product applications.`;
---
<SiteLayout locale={locale} title={`${title} — SD Tech Systems`} description={description} path="marcas/">
  <nav class="wrap detail-nav" aria-label={es ? 'Navegación' : 'Navigation'}><a href={`${base}${locale}/`}>← {es ? 'Inicio' : 'Home'}</a><Brand href={`${base}${locale}/`} /><LanguageSwitch locale={locale} path="marcas/" /></nav>
  <main id="contenido">
    <section class="wrap brands-hero" aria-labelledby="marcas-titulo">
      <p class="eyebrow">{es ? `PORTAFOLIO DE DISEÑO · ${brands.length} MARCAS` : `DESIGN PORTFOLIO · ${brands.length} BRANDS`}</p>
      <h1 id="marcas-titulo">{es ? <>Marcas que se ven <span>y se recuerdan.</span></> : <>Brands people see <span>and remember.</span></>}</h1>
      <div class="brands-lead">
        <p>{es
          ? `Explora ${brands.length} identidades completas: minimalistas, sobrias, llamativas, elegantes, artesanales, divertidas, retro, tecnológicas y de lujo con monogramas. Cada una muestra el logo y sus versiones, la paleta, las tipografías, las piezas para redes, la imagen corporativa y cómo se ve en sus productos.`
          : `Explore ${brands.length} complete identities: minimal, professional, bold, elegant, organic, playful, retro, tech and luxury monograms. Each one shows the logo and its versions, palette, typefaces, social media pieces, corporate identity and how it looks on products.`}</p>
        <div class="brand-actions"><a class="brand-btn wa" href={wa} target="_blank" rel="noopener noreferrer"><WhatsAppIcon />{es ? 'Cotizar por WhatsApp' : 'Get a quote on WhatsApp'}</a><a class="brand-btn" href={form}>{es ? 'Llenar el brief de marca' : 'Fill in the brand brief'}{!es && <small> · ES</small>} ↗</a></div>
      </div>
      <p class="brands-note">{es
        ? 'Marcas ficticias creadas por SD Tech Systems para mostrar el servicio. Nombres, productos y datos son ilustrativos.'
        : 'Fictional brands created by SD Tech Systems to showcase the service. Names, products and details are illustrative.'}</p>
    </section>

    <section class="wrap" aria-label={es ? 'Galería de marcas' : 'Brand gallery'}>
      <div class="filter-bar"><div class="filters" role="group" aria-label={es ? 'Filtrar por estilo' : 'Filter by style'}><button data-brand-filter="all" aria-pressed="true">{es ? 'Todas' : 'All'} <span>{brands.length}</span></button>{brandStyles.map(s => <button data-brand-filter={s.id} aria-pressed="false">{s.label[locale]} <span>{brands.filter(b => b.style === s.id).length}</span></button>)}</div><span class="filter-count" role="status" aria-live="polite" data-plural={es ? 'marcas' : 'brands'} data-singular={es ? 'marca' : 'brand'}>{brands.length} {es ? 'marcas' : 'brands'}</span></div>
      <div class="brand-grid">{brands.map((b, i) => <BrandCard brand={b} locale={locale} eager={i < 3} heading="h2" />)}</div>
    </section>

    <section class="wrap bp-section" aria-labelledby="paquete-titulo">
      <p class="eyebrow">{es ? 'QUÉ RECIBES' : 'WHAT YOU GET'}</p>
      <h2 id="paquete-titulo" class="bp-title">{es ? 'Tu marca, lista para usar' : 'Your brand, ready to use'}<span>.</span></h2>
      <div class="package">
        <div class="package-card"><p class="package-tag">{es ? 'PAQUETE DE MARCA' : 'BRAND PACKAGE'}</p><h3>{es ? 'Identidad visual' : 'Visual identity'}</h3><ul>{packageItems[locale].map(i => <li>{i}</li>)}</ul></div>
        <div class="package-card alt"><p class="package-tag">{es ? 'SE COTIZA APARTE' : 'QUOTED SEPARATELY'}</p><h3>{es ? 'Imagen corporativa' : 'Corporate identity'}</h3><p class="package-copy">{es ? 'Llevamos la marca a todo lo que toca tu cliente: papelería, piezas digitales, uniformes, avisos y empaques.' : 'We carry the brand into everything your customers touch: stationery, digital pieces, uniforms, signs and packaging.'}</p><ul>{corporateItems[locale].map(i => <li>{i}</li>)}</ul></div>
      </div>
      <div class="brand-actions brands-end"><a class="brand-btn wa" href={wa} target="_blank" rel="noopener noreferrer"><WhatsAppIcon />{es ? 'Hablemos por WhatsApp' : 'Chat on WhatsApp'}</a><a class="brand-btn" href={form}>{es ? 'Empezar con el brief' : 'Start with the brief'}{!es && <small> · ES</small>} ↗</a></div>
    </section>
  </main>
<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-brand-filter]');
  buttons.forEach(button => button.addEventListener('click', () => {
    buttons.forEach(b => b.setAttribute('aria-pressed', String(b === button)));
    let count = 0;
    document.querySelectorAll<HTMLElement>('.brand-card').forEach(card => {
      card.hidden = button.dataset.brandFilter !== 'all' && card.dataset.style !== button.dataset.brandFilter;
      if (!card.hidden) count++;
    });
    const label = document.querySelector<HTMLElement>('.filter-count');
    if (label) label.textContent = `${count} ${count === 1 ? label.dataset.singular : label.dataset.plural}`;
  }));
</script>
</SiteLayout>
