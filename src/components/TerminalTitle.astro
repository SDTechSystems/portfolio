---
// Page title typed letter by letter like a terminal, ending in a blinking "_" caret.
// The second line (optional) is rendered in <em> so each page can give it the accent color.
const { first, second, id = 'titulo' } = Astro.props as { first: string; second?: string; id?: string };
const firstLine = Array.from(first), lastLine = Array.from(second ?? '');
const caretIn = (line: string[], index: number, last: boolean) => last && index === line.length - 1 ? 'after' : undefined;
---
<script is:inline>
  // Hide only while the animation initializes. Failed scripts reveal the full title.
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches && !document.documentElement.hasAttribute('data-motion')) {
    document.documentElement.dataset.terminalBoot = 'pending';
    window.setTimeout(() => {
      if (document.documentElement.dataset.terminalBoot === 'pending') delete document.documentElement.dataset.terminalBoot;
    }, 1600);
  }
</script>
<h1 id={id} class="terminal-heading" aria-label={second ? `${first} ${second}` : first} data-terminal-state="complete"><span aria-hidden="true"><span data-terminal-line>{firstLine.map((letter, index) => <span data-terminal-char data-caret={caretIn(firstLine, index, !second)}>{letter}</span>)}</span>{second && <><br/><em data-terminal-line>{lastLine.map((letter, index) => <span data-terminal-char data-caret={caretIn(lastLine, index, true)}>{letter}</span>)}</em></>}</span></h1>
<script>
  import '../scripts/terminal-title';
</script>
