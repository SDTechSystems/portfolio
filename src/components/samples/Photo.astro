---
// A sample-site photo from public/muestras/<site>/<slot>.webp. Until the file exists it renders
// a blank block with the same proportions, so the layout never jumps when the photo is added.
import { publicExists } from '../../lib/public-file';
const { site, slot, alt = '', ratio = '4/3', eager = false, class: cls = '', sizes = '100vw' } = Astro.props as { site: string; slot: string; alt?: string; ratio?: string; eager?: boolean; class?: string; sizes?: string };
const base = import.meta.env.BASE_URL;
const file = `muestras/${site}/${slot}.webp`, small = `muestras/${site}/${slot}-sm.webp`;
const [w, h] = ratio.split('/').map(Number);
const width = 1600, height = Math.round(width * h / w);
const has = publicExists(file), hasSmall = publicExists(small);
---
{has
  ? <img class:list={['ph-img', cls]} src={`${base}${file}`} srcset={hasSmall ? `${base}${small} 720w, ${base}${file} 1600w` : undefined} sizes={hasSmall ? sizes : undefined} alt={alt} width={width} height={height} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding="async" style={`aspect-ratio:${ratio}`} />
  : <span class:list={['ph', cls]} role={alt ? 'img' : undefined} aria-label={alt || undefined} style={`aspect-ratio:${ratio}`}></span>}
