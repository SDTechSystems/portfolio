---
// Floating WhatsApp button for demo pages, bottom-left so it never covers the accessibility launcher.
import WhatsAppIcon from './WhatsAppIcon.astro';
const { href, label } = Astro.props as { href: string; label: string };
---
<a class="wa-fab" href={href} target="_blank" rel="noopener noreferrer" aria-label={label}><WhatsAppIcon/><span>{label}</span></a>
<style>
  .wa-fab{position:fixed;left:18px;bottom:18px;z-index:60;display:inline-flex;align-items:center;gap:9px;padding:11px 16px 11px 12px;border-radius:40px;background:#0b6e38;border:1px solid #25d366;color:#fff;font:600 .85rem/1.2 system-ui,sans-serif;text-decoration:none;box-shadow:0 10px 28px #0007;transition:transform .25s cubic-bezier(.34,1.56,.64,1),background .2s;animation:wa-fab-in .6s 1.2s cubic-bezier(.16,1,.3,1) both}
  .wa-fab:hover{background:#085c2e;transform:translateY(-3px)}
  .wa-fab:focus-visible{outline:3px solid #2563EB;outline-offset:4px}
  .wa-fab :global(.wa-icon){width:22px;height:22px;fill:currentColor;flex:none}
  .wa-fab::before{content:"";position:absolute;inset:-1px;border-radius:inherit;border:2px solid #25d366;animation:wa-fab-pulse 2.6s 2s ease-out infinite;pointer-events:none}
  @keyframes wa-fab-in{from{opacity:0;transform:translateY(20px) scale(.9)}to{opacity:1;transform:none}}
  @keyframes wa-fab-pulse{0%{opacity:.8;transform:scale(1)}70%,100%{opacity:0;transform:scale(1.18,1.4)}}
  @media(max-width:600px){.wa-fab{left:14px;bottom:14px;padding:12px}.wa-fab span{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}}
  @media(prefers-reduced-motion:reduce){.wa-fab,.wa-fab::before{animation:none}}
  :global(html[data-motion]) .wa-fab,:global(html[data-motion]) .wa-fab::before{animation:none}
</style>
