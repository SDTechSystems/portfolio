---
// Barra del pedido: los elementos con data-item (ver item() en lib/catalogo.ts) se marcan con
// aria-pressed y se envían juntos en un solo WhatsApp. Sin JavaScript, cada uno abre su propio WhatsApp.
import { tienda } from '../data/tienda';
---
<p id="anuncio" class="solo-lector" aria-live="polite"></p>
<aside id="pedido" class="pedido" aria-label="Tu pedido" hidden data-locale={tienda.locale} data-moneda={tienda.moneda} data-wa={tienda.whatsapp}>
  <strong class="total"></strong>
  <button type="button" class="vaciar">Vaciar</button>
  <a class="cta" href="#" target="_blank" rel="noopener">Pedir<span class="largo"> por WhatsApp</span></a>
</aside>

<script>
  const bar = document.getElementById('pedido')!;
  const total = bar.querySelector('.total')!;
  // El lector de pantalla oye "Total del pedido: …" al elegir o quitar; fuera de la barra para que
  // también se anuncie cuando la barra pasa de oculta a visible.
  const anuncio = document.getElementById('anuncio')!;
  const cta = bar.querySelector<HTMLAnchorElement>('.cta')!;
  const fmt = new Intl.NumberFormat(bar.dataset.locale, { style: 'currency', currency: bar.dataset.moneda, maximumFractionDigits: 0 });
  const items = [...document.querySelectorAll<HTMLAnchorElement>('[data-item]')];
  const marcar = (el: HTMLElement, on: boolean) => el.setAttribute('aria-pressed', String(on));
  // La selección sobrevive si el celular recarga la pestaña al volver de WhatsApp.
  // sessionStorage puede fallar (modo privado, bloqueado): entonces solo no se guarda.
  const CLAVE = 'pedido';
  let guardados: string[] = [];
  try {
    const valor: unknown = JSON.parse(sessionStorage.getItem(CLAVE) ?? '[]');
    if (Array.isArray(valor)) guardados = valor.filter((id): id is string => typeof id === 'string');
  } catch {}

  items.forEach((el) => {
    el.setAttribute('role', 'button');
    marcar(el, guardados.includes(el.dataset.item!));
    el.addEventListener('click', (e) => {
      e.preventDefault();
      marcar(el, el.getAttribute('aria-pressed') !== 'true');
      pintar(true);
    });
    // Un botón también se activa con Espacio (un enlace solo con Enter).
    el.addEventListener('keydown', (e) => {
      if (e.key === ' ') { e.preventDefault(); el.click(); }
    });
  });
  bar.querySelector('.vaciar')!.addEventListener('click', () => { items.forEach((el) => marcar(el, false)); pintar(true); });
  pintar();

  function pintar(anunciar = false) {
    const elegidos = items.filter((el) => el.getAttribute('aria-pressed') === 'true');
    try { sessionStorage.setItem(CLAVE, JSON.stringify(elegidos.map((el) => el.dataset.item))); } catch {}
    const suma = elegidos.reduce((s, el) => s + Number(el.dataset.precio), 0);
    const lineas = elegidos.map((el) => `• ${el.dataset.nombre} (${el.dataset.detalle}) ${fmt.format(Number(el.dataset.precio))}`);
    bar.hidden = elegidos.length === 0;
    total.textContent = fmt.format(suma);
    // Con el panel de versiones abierto, lo de afuera es inerte: se anuncia desde el panel.
    const destino = document.querySelector('dialog[open] [data-anuncio]') ?? anuncio;
    if (anunciar) destino.textContent = elegidos.length ? `Total del pedido: ${fmt.format(suma)}` : 'Pedido vacío';
    cta.href = `https://wa.me/${bar.dataset.wa}?text=${encodeURIComponent(`Hola, quiero pedir:\n${lineas.join('\n')}\nTotal: ${fmt.format(suma)}`)}`;
  }
</script>

<style>
  .pedido {
    position: fixed; left: 12px; right: 12px; bottom: 12px; z-index: 10; max-width: 560px; margin: 0 auto;
    display: flex; align-items: center; gap: 12px; padding: 10px 10px 10px 20px;
    background: var(--tinta); color: var(--suelo); border-radius: 999px;
    box-shadow: 0 8px 24px var(--sombra); /* flota: solo lo que flota lleva sombra */
    animation: subir .25s cubic-bezier(.2, .8, .2, 1);
  }
  .pedido[hidden] { display: none; }
  .total { flex: 1; font-size: 19px; white-space: nowrap; }
  .vaciar { font: inherit; font-size: 14px; background: none; border: 0; color: inherit; opacity: .7; cursor: pointer; padding: 8px 4px; }
  .cta { background: var(--acento); color: var(--sobre-acento); font-weight: 800; font-size: 15px; padding: 12px 18px; border-radius: 999px; white-space: nowrap; }
  .cta:active, .vaciar:active { transform: scale(.96); }
  @keyframes subir { from { transform: translateY(24px); opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .pedido { animation: none; } }
  /* Teléfonos estrechos: se vacía tocando de nuevo los mosaicos. */
  @media (max-width: 420px) { .vaciar { display: none; } .pedido { gap: 8px; padding-left: 16px; } .total { font-size: 17px; } .cta { padding: 12px 14px; } }
  /* 320–340px con un total de 7 cifras: el botón se salía 5px de la barra. */
  /* Con la tipografía de SD Tech (más ancha) el total y el botón se achican un poco más. */
  /* 320–360px: con la tipografía de SD Tech (más ancha) el botón dice solo «Pedir»; el lector de pantalla sigue
     oyendo «Pedir por WhatsApp». */
  @media (max-width: 360px) { .pedido { gap: 6px; padding-left: 14px; } .total { font-size: 16px; } .cta { padding: 12px 16px; } .largo { position: absolute; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; } }
  :global(body:has(.pedido:not([hidden]))) { padding-bottom: 84px; }
  /* Al moverse con Tab, el mosaico con foco se desplaza por encima de la barra y no queda tapado. */
  :global(html:has(.pedido:not([hidden]))) { scroll-padding-bottom: 96px; }
  /* Dentro de la barra clara el contorno de foco va oscuro. */
  .pedido :focus-visible { outline-color: var(--suelo); }
  .solo-lector { position: absolute; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
</style>
