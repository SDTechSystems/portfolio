---
import { Font } from 'astro:assets';
import { tienda } from '../data/tienda';
const descripcion = 'Códigos digitales de juegos para Nintendo Switch 1 y 2.';
// Vista previa al compartir (WhatsApp, Facebook…): exige direcciones absolutas, así que
// solo se publica cuando tienda.url está lleno (astro.config.mjs → site).
const imagen = Astro.site && new URL('/og.jpg', Astro.site).href;
const canonica = Astro.site && new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#eef5fb" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#07111f" media="(prefers-color-scheme: dark)" />
		<script is:inline>
			// Tema antes de pintar (sin parpadeo): lo elegido en este navegador o, si no, el del sistema.
			(() => {
				const html = document.documentElement, sistema = matchMedia('(prefers-color-scheme: dark)');
				const guardado = () => { try { return localStorage.getItem('tema'); } catch { return null; } };
				const poner = (t) => {
					html.dataset.tema = t;
					for (const m of document.querySelectorAll('meta[name="theme-color"]')) m.content = t === 'oscuro' ? '#07111f' : '#eef5fb';
				};
				const g = guardado();
				poner(g === 'claro' || g === 'oscuro' ? g : sistema.matches ? 'oscuro' : 'claro');
				// Si nunca eligió, sigue al sistema cuando este cambia.
				sistema.addEventListener('change', (e) => { if (!guardado()) poner(e.matches ? 'oscuro' : 'claro'); });
				window.ponerTema = poner;
			})();
		</script>
		<meta name="description" content={descripcion} />
		<link rel="icon" type="image/png" sizes="48x48" href="/favicon.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<Font cssVariable="--fuente" preload />
		<Font cssVariable="--mono" />
		<title>{tienda.nombre}</title>
		{canonica && <link rel="canonical" href={canonica} />}
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_CO" />
		<meta property="og:site_name" content={tienda.nombre} />
		<meta property="og:title" content={`${tienda.nombre} · Códigos para Switch 1 y 2`} />
		<meta property="og:description" content={descripcion} />
		{canonica && <meta property="og:url" content={canonica} />}
		{imagen && (
			<>
				<meta property="og:image" content={imagen} />
				<meta property="og:image:type" content="image/jpeg" />
				<meta property="og:image:width" content="1200" />
				<meta property="og:image:height" content="630" />
				<meta property="og:image:alt" content="Portadas de los juegos destacados de la tienda" />
				<meta name="twitter:card" content="summary_large_image" />
			</>
		)}
	</head>
	<body>
		<slot />
	</body>
</html>
<style is:global>
	/* Tokens del diseño (docs/diseno.md §2), con la paleta de SD Tech Imports (navy #001B44 y cian #00BFEF)
	   y el aire del portafolio de SD Tech. Únicos colores permitidos. Claro por defecto;
	   oscuro si se eligió (data-tema) o, sin JavaScript, si el sistema lo pide. */
	:root { color-scheme: light; --suelo: #eef5fb; --mosaico: #ffffff; --tinta: #0d1b33; --suave: #5d6778; --suave-sel: #a7b9cd; --sin-portada: #d6e2ee; --sombra: rgb(6 28 69 / .25); --acento: #00bfef; --acento-texto: #0094c6; --sobre-acento: #001b44; --linea: #d6e2ee; }
	:root[data-tema='oscuro'] { color-scheme: dark; --suelo: #07111f; --mosaico: #0f1e36; --tinta: #f4f8fc; --suave: #a7b9cd; --suave-sel: #4a5b72; --sin-portada: #1a2b47; --sombra: rgb(0 0 0 / .6); --linea: #2c405b; --acento-texto: #00bfef; }
	@media (prefers-color-scheme: dark) {
		:root:not([data-tema]) { color-scheme: dark; --suelo: #07111f; --mosaico: #0f1e36; --tinta: #f4f8fc; --suave: #a7b9cd; --suave-sel: #4a5b72; --sin-portada: #1a2b47; --sombra: rgb(0 0 0 / .6); --linea: #2c405b; --acento-texto: #00bfef; }
	}
	/* Vidrio líquido de lo que flota (lupa y campo de búsqueda): el mosaico casi transparente y un canto
	   de luz (--brillo, reflejo arriba a la izquierda; --brillo-suave, canto y resplandor interior). */
	/* --canto: el lado en sombra del grosor del vidrio (abajo a la derecha); en claro es lo que lo despega del blanco. */
	:root { --vidrio: color-mix(in srgb, var(--mosaico) 40%, transparent); --brillo: rgb(255 255 255 / .95); --brillo-suave: rgb(255 255 255 / .4); --canto: rgb(0 0 0 / .14); }
	:root[data-tema='oscuro'] { --brillo: rgb(255 255 255 / .45); --brillo-suave: rgb(255 255 255 / .12); --canto: rgb(0 0 0 / .4); }
	@media (prefers-color-scheme: dark) {
		:root:not([data-tema]) { --brillo: rgb(255 255 255 / .45); --brillo-suave: rgb(255 255 255 / .12); --canto: rgb(0 0 0 / .4); }
	}
	/* Vidrio de lo que se superpone (pestañas sobre portadas, panel del destacado, barra del pedido, panel de
	   versiones): --relieve es el canto de luz del vidrio líquido; --cristal, el vidrio oscuro de las pestañas
	   sobre las portadas (igual en los dos modos: van sobre la imagen, no sobre el suelo). */
	:root {
		--relieve: inset 0 0 0 1px var(--brillo-suave), inset 1.5px 2px 1px -1px var(--brillo),
			inset -1.5px -2px 1px -1px var(--brillo-suave), inset -3px -4px 8px -4px var(--canto);
		--desenfoque: blur(16px) saturate(1.7);
		--cristal: rgb(7 17 31 / .58); --sobre-cristal: #f4f8fc;
		--acento-cristal: color-mix(in srgb, var(--acento) 80%, transparent);
	}
	*, *::before, *::after { box-sizing: border-box; }
	html, body { margin: 0; }
	body {
		background: var(--suelo); color: var(--tinta);
		font-family: var(--fuente);
		-webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility;
	}
	a { color: inherit; text-decoration: none; -webkit-tap-highlight-color: transparent; }
	img { max-width: 100%; }
	h1, h2, p { margin: 0; }
	/* Foco en tinta sobre el suelo: 16:1 en claro, 18:1 en oscuro. */
	:focus-visible { outline: 3px solid var(--tinta); outline-offset: 2px; }
</style>
