---
import { Font } from 'astro:assets';
import { tienda } from '../data/tienda';
const descripcion = 'Códigos digitales de juegos para Nintendo Switch 1 y 2.';
// Vista previa al compartir (WhatsApp, Facebook…): exige direcciones absolutas, así que
// solo se publica cuando tienda.url está lleno (astro.config.mjs → site).
const imagen = Astro.site && new URL('/og.jpg', Astro.site).href;
const canonica = Astro.site && new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#e9e9ec" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#0e0e10" media="(prefers-color-scheme: dark)" />
		<script is:inline>
			// Tema antes de pintar (sin parpadeo): lo elegido en este navegador o, si no, el del sistema.
			(() => {
				const html = document.documentElement, sistema = matchMedia('(prefers-color-scheme: dark)');
				const guardado = () => { try { return localStorage.getItem('tema'); } catch { return null; } };
				const poner = (t) => {
					html.dataset.tema = t;
					for (const m of document.querySelectorAll('meta[name="theme-color"]')) m.content = t === 'oscuro' ? '#0e0e10' : '#e9e9ec';
				};
				const g = guardado();
				poner(g === 'claro' || g === 'oscuro' ? g : sistema.matches ? 'oscuro' : 'claro');
				// Si nunca eligió, sigue al sistema cuando este cambia.
				sistema.addEventListener('change', (e) => { if (!guardado()) poner(e.matches ? 'oscuro' : 'claro'); });
				window.ponerTema = poner;
			})();
		</script>
		<meta name="description" content={descripcion} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<Font cssVariable="--fuente" preload />
		<title>{tienda.nombre}</title>
		{canonica && <link rel="canonical" href={canonica} />}
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_CO" />
		<meta property="og:site_name" content={tienda.nombre} />
		<meta property="og:title" content={`${tienda.nombre} · Códigos para Switch 1 y 2`} />
		<meta property="og:description" content={descripcion} />
		{canonica && <meta property="og:url" content={canonica} />}
		{imagen && (
			<>
				<meta property="og:image" content={imagen} />
				<meta property="og:image:type" content="image/jpeg" />
				<meta property="og:image:width" content="1200" />
				<meta property="og:image:height" content="630" />
				<meta property="og:image:alt" content="Portadas de los juegos destacados de la tienda" />
				<meta name="twitter:card" content="summary_large_image" />
			</>
		)}
	</head>
	<body>
		<slot />
	</body>
</html>
<style is:global>
	/* Tokens del diseño (docs/diseno.md §2). Únicos colores permitidos. Claro por defecto;
	   oscuro si se eligió (data-tema) o, sin JavaScript, si el sistema lo pide. */
	:root { color-scheme: light; --suelo: #e9e9ec; --mosaico: #ffffff; --tinta: #121214; --suave: #5b5b63; --suave-sel: #b9b9c2; --sin-portada: #d6d6dc; --sombra: rgb(0 0 0 / .28); --rojo: #e60012; }
	:root[data-tema='oscuro'] { color-scheme: dark; --suelo: #0e0e10; --mosaico: #1c1c21; --tinta: #f5f5f7; --suave: #a1a1aa; --suave-sel: #55555e; --sin-portada: #26262c; --sombra: rgb(0 0 0 / .6); }
	@media (prefers-color-scheme: dark) {
		:root:not([data-tema]) { color-scheme: dark; --suelo: #0e0e10; --mosaico: #1c1c21; --tinta: #f5f5f7; --suave: #a1a1aa; --suave-sel: #55555e; --sin-portada: #26262c; --sombra: rgb(0 0 0 / .6); }
	}
	*, *::before, *::after { box-sizing: border-box; }
	html, body { margin: 0; }
	body {
		background: var(--suelo); color: var(--tinta);
		font-family: var(--fuente);
		-webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility;
	}
	a { color: inherit; text-decoration: none; -webkit-tap-highlight-color: transparent; }
	img { max-width: 100%; }
	h1, h2, p { margin: 0; }
	/* Foco en tinta sobre el suelo: 16:1 en claro, 18:1 en oscuro. */
	:focus-visible { outline: 3px solid var(--tinta); outline-offset: 2px; }
</style>
