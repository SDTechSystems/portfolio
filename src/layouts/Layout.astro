---
import { tienda } from '../data/tienda';
interface Props { titulo?: string; tema?: string }
const { titulo = tienda.nombre, tema = '#e60012' } = Astro.props;
---
<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content={tema} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800;900&display=swap" />
		<title>{titulo}</title>
	</head>
	<body>
		<slot />
	</body>
</html>
<style is:global>
	*, *::before, *::after { box-sizing: border-box; }
	html, body { margin: 0; }
	body { font-family: Inter, system-ui, sans-serif; -webkit-font-smoothing: antialiased; }
	a { color: inherit; text-decoration: none; }
	img { max-width: 100%; }
</style>
