---
import SampleLayout from '../../components/samples/SampleLayout.astro';
import Photo from '../../components/samples/Photo.astro';
import Logo from '../../components/samples/Logo.astro';
const S = 'sereno';
const steps = [
  { n: '01', slot: 'limpiar', t: 'Limpia', d: 'Dos gotas de limpiador en la piel húmeda. Masajea treinta segundos y retira con agua tibia.' },
  { n: '02', slot: 'tratar', t: 'Trata', d: 'Tres gotas de Sérum Calma sobre el rostro aún húmedo. Presiona con las palmas, sin frotar.' },
  { n: '03', slot: 'proteger', t: 'Protege', d: 'Sella con la crema ligera. De día, termina siempre con protector solar.' },
];
const ingredients = [
  { name: 'Niacinamida', pct: 5, d: 'Unifica el tono y ayuda a controlar el brillo.' },
  { name: 'Centella asiática', pct: 3, d: 'Calma las rojeces y la sensación de ardor.' },
  { name: 'Ácido hialurónico', pct: 1.5, d: 'Retiene agua en la piel durante el día.' },
  { name: 'Escualano vegetal', pct: 1, d: 'Suaviza sin dejar sensación grasa.' },
];
const faq = [
  ['¿Sirve para piel sensible?', 'Sí. La fórmula no tiene fragancia, alcohol ni aceites esenciales y fue probada en piel sensible bajo control dermatológico.'],
  ['¿Cuándo veo resultados?', 'La sensación de calma es inmediata. La textura y el tono mejoran de forma visible entre la cuarta y la sexta semana de uso diario.'],
  ['¿Puedo usarlo con retinol o vitamina C?', 'Sí. Aplica Sérum Calma después de tu activo y espera un minuto antes de la crema.'],
  ['¿Cuánto dura un frasco?', 'Con tres gotas mañana y noche, los 30 ml rinden cerca de dos meses.'],
];
---
<SampleLayout slug={S} title="Sereno — Sérum Calma" description="Un solo sérum, tres gestos. Únete a la lista de espera de Sérum Calma." theme="#F4F0EA"
  fonts={[{ family: 'Jost', file: 'jost-latin-300-normal.woff2', weight: 300 }, { family: 'Karla', file: 'karla-latin-400-normal.woff2', weight: 400 }, { family: 'Jost', file: 'jost-latin-400-normal.woff2', weight: 400 }, { family: 'Jost', file: 'jost-latin-500-normal.woff2', weight: 500 }, { family: 'Karla', file: 'karla-latin-600-normal.woff2', weight: 600 }]}>
  <div class="se">
    <header class="se-head">
      <a href="#inicio" aria-label="Sereno, inicio"><Logo brand={S} height={22} /></a>
      <nav aria-label="Secciones"><a href="#ritual">Ritual</a><a href="#formula">Fórmula</a><a href="#preguntas">Preguntas</a></nav>
      <a class="se-link" href="#lista">Lista de espera</a>
    </header>
    <main id="inicio">
      <section class="se-hero">
        <div class="se-hero-copy">
          <p class="se-over">Nuevo · Sérum Calma 30 ml</p>
          <h1>Piel en calma.</h1>
          <p class="se-lead">Un solo sérum para pieles que se irritan con todo. Cuatro ingredientes, cero fragancia y una rutina que cabe en un minuto.</p>
          <a class="se-btn" href="#lista">Quiero ser de los primeros</a>
          <p class="se-small">Lanzamiento en marzo · $98.000</p>
        </div>
        <Photo site={S} slot="hero" ratio="4/5" eager alt="Frasco de sérum sobre una piedra de travertino con luz de mañana" class="se-hero-img" sizes="(max-width: 820px) 100vw, 45vw" />
      </section>

      <section class="se-band" data-reveal><p>“Menos pasos, mejor piel. Diseñamos Sereno para la mañana en que no tienes tiempo y la noche en que no tienes ganas.”</p></section>

      <section class="se-section" id="ritual" aria-labelledby="ritual-t">
        <div class="se-title" data-reveal><p class="se-over">El ritual</p><h2 id="ritual-t">Tres gestos. Un minuto.</h2></div>
        <ol class="se-steps">
          {steps.map(s => <li data-reveal><Photo site={S} slot={s.slot} ratio="3/4" alt="" sizes="(max-width: 820px) 100vw, 30vw" /><span class="se-num">{s.n}</span><h3>{s.t}</h3><p>{s.d}</p></li>)}
        </ol>
      </section>

      <section class="se-section se-formula" id="formula" aria-labelledby="formula-t">
        <div class="se-title" data-reveal><p class="se-over">La fórmula</p><h2 id="formula-t">Cuatro ingredientes.<br />Nada más.</h2><p class="se-copy">Sin fragancia, sin alcohol, sin colorantes. Cada ingrediente está en la concentración que funciona y lo decimos con números.</p></div>
        <ul class="se-ingredients">
          {ingredients.map(i => <li data-reveal><div class="se-ing-row"><b>{i.name}</b><span>{String(i.pct).replace('.', ',')} %</span></div><i style={`--w:${i.pct / 5}`} aria-hidden="true"></i><p>{i.d}</p></li>)}
        </ul>
      </section>

      <section class="se-skin" aria-label="Testimonio">
        <Photo site={S} slot="piel" ratio="16/9" alt="Retrato de una mujer con la piel luminosa y los ojos cerrados" sizes="100vw" />
        <blockquote data-reveal><p>“Por primera vez en años, mi piel no se queja después de la rutina.”</p><footer>Laura M. · piel sensible · prueba de uso de 6 semanas</footer></blockquote>
      </section>

      <section class="se-section se-faq" id="preguntas" aria-labelledby="faq-t">
        <div class="se-title" data-reveal><p class="se-over">Preguntas</p><h2 id="faq-t">Lo que suelen preguntarnos</h2></div>
        <div class="se-faq-list">{faq.map(([q, a]) => <details data-reveal><summary>{q}<span aria-hidden="true"></span></summary><p>{a}</p></details>)}</div>
      </section>

      <section class="se-wait" id="lista" aria-labelledby="lista-t">
        <h2 id="lista-t" data-reveal>Sé de los primeros.</h2>
        <p data-reveal>Te avisamos el día del lanzamiento con un 15 % de descuento. Un correo, nada más.</p>
        <form class="se-form" data-wait novalidate>
          <label for="se-email" class="se-sr">Correo electrónico</label>
          <input id="se-email" type="email" required autocomplete="email" placeholder="tu@correo.com" />
          <button type="submit" class="se-btn">Unirme</button>
          <label class="se-check"><input type="checkbox" required /> Acepto recibir el aviso de lanzamiento.</label>
          <p class="se-msg" role="status" aria-live="polite"></p>
        </form>
      </section>
    </main>
    <footer class="se-foot"><Logo brand={S} variant="logo-simbolo" height={34} /><p>Sereno · Cuidado de la piel · Bogotá</p><p>Hecho con calma.</p></footer>
  </div>
</SampleLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-wait]')!;
  const msg = form.querySelector<HTMLElement>('.se-msg')!;
  form.addEventListener('submit', e => {
    e.preventDefault();
    const email = form.querySelector<HTMLInputElement>('input[type=email]')!;
    const ok = form.querySelector<HTMLInputElement>('input[type=checkbox]')!;
    if (!email.checkValidity() || !email.value) { msg.textContent = 'Escribe un correo válido.'; email.focus(); return; }
    if (!ok.checked) { msg.textContent = 'Marca la casilla para continuar.'; ok.focus(); return; }
    msg.textContent = `Listo. Te escribiremos a ${email.value} el día del lanzamiento. (Muestra: no se guardó ningún dato.)`;
    form.classList.add('is-done');
  });
</script>

<style is:global>
  .se{--bone:#F4F0EA;--sand:#DCCFBE;--sage:#8C9A84;--sage-d:#5f6d58;--ink:#2E2E2C;background:var(--bone);color:var(--ink);font:400 17px/1.7 Karla,system-ui,sans-serif}
  .se *{box-sizing:border-box}
  .se h1,.se h2,.se h3{margin:0;font-family:Jost,sans-serif;font-weight:300;letter-spacing:-.02em;line-height:1.05}
  .se p{margin:0}
  .se a{color:inherit}
  .se :focus-visible{outline:2px solid var(--ink);outline-offset:4px}
  .se-sr{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}
  .se-head{position:sticky;top:0;z-index:50;display:flex;align-items:center;gap:40px;padding:22px clamp(20px,6vw,90px);background:#f4f0eaeb;backdrop-filter:blur(8px)}
  .se-head img{display:block;height:22px;width:auto}
  .se-head nav{display:flex;gap:32px;margin-left:auto;font-size:14px;letter-spacing:.06em;text-transform:uppercase}
  .se-head nav a,.se-link{text-decoration:none}
  .se-link{font-size:14px;letter-spacing:.06em;text-transform:uppercase;border-bottom:1px solid var(--ink);padding-bottom:2px}
  .se-over{font:500 13px/1 Jost,sans-serif;letter-spacing:.18em;text-transform:uppercase;color:var(--sage-d)}
  .se-hero{display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:clamp(30px,6vw,110px);padding:clamp(40px,7vw,110px) clamp(20px,6vw,90px)}
  .se-hero h1{margin:22px 0 26px;font-size:clamp(3.6rem,9vw,8.5rem)}
  .se-lead{max-width:34ch;font-size:1.15rem;color:#4d4b47}
  .se-btn{display:inline-flex;align-items:center;justify-content:center;min-height:52px;margin-top:34px;padding:12px 30px;border:1px solid var(--ink);border-radius:0;background:var(--ink);color:var(--bone)!important;font:500 14px Jost,sans-serif;letter-spacing:.14em;text-transform:uppercase;text-decoration:none;cursor:pointer;transition:background .3s,color .3s}
  .se-btn:hover{background:transparent;color:var(--ink)!important}
  .se-small{margin-top:16px;font-size:14px;color:#6e6a63}
  .se-hero-img{border-radius:220px 220px 0 0}
  .se-band{padding:clamp(50px,8vw,120px) clamp(20px,12vw,220px);background:var(--sand);text-align:center}
  .se-band p{font:300 clamp(1.4rem,2.8vw,2.3rem)/1.4 Jost,sans-serif}
  .se-section{padding:clamp(70px,10vw,150px) clamp(20px,6vw,90px)}
  .se-title{max-width:620px;margin-bottom:56px}
  .se-title h2{margin-top:18px;font-size:clamp(2.4rem,5vw,4.2rem)}
  .se-copy{margin-top:22px;color:#55534e}
  .se-steps{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(20px,3vw,48px);margin:0;padding:0;list-style:none}
  .se-steps li{display:flex;flex-direction:column;gap:10px}
  .se-num{margin-top:14px;font:300 15px Jost,sans-serif;color:var(--sage-d)}
  .se-steps h3{font-size:2rem}
  .se-steps p{color:#55534e}
  .se-formula{display:grid;grid-template-columns:.9fr 1.1fr;gap:clamp(30px,6vw,100px);border-top:1px solid #2e2e2c22}
  .se-ingredients{margin:0;padding:0;list-style:none}
  .se-ingredients li{padding:24px 0;border-bottom:1px solid #2e2e2c22}
  .se-ing-row{display:flex;justify-content:space-between;gap:16px;font:400 1.3rem Jost,sans-serif}
  .se-ing-row span{color:var(--sage-d)}
  .se-ingredients i{display:block;height:2px;margin:12px 0;background:linear-gradient(90deg,var(--sage) calc(var(--w)*100%),#2e2e2c14 0)}
  .se-ingredients p{color:#55534e;font-size:15px}
  .se-skin{position:relative;background:var(--sand)}
  .se-skin blockquote{position:absolute;left:clamp(20px,6vw,90px);bottom:clamp(20px,5vw,70px);max-width:440px;margin:0;padding:32px;background:#f4f0eaee}
  .se-skin blockquote p{font:300 1.6rem/1.3 Jost,sans-serif}
  .se-skin blockquote footer{margin-top:16px;font-size:14px;color:#6e6a63}
  .se-faq{max-width:1000px;margin:0 auto}
  .se-faq details{border-bottom:1px solid #2e2e2c33}
  .se-faq summary{display:flex;align-items:center;justify-content:space-between;gap:20px;min-height:72px;padding:14px 0;font:400 1.25rem Jost,sans-serif;list-style:none;cursor:pointer}
  .se-faq summary::-webkit-details-marker{display:none}
  .se-faq summary span{position:relative;flex:none;width:16px;height:16px}
  .se-faq summary span::before,.se-faq summary span::after{content:"";position:absolute;top:7px;left:0;width:16px;height:1.5px;background:var(--ink);transition:transform .3s}
  .se-faq summary span::after{transform:rotate(90deg)}
  .se-faq details[open] summary span::after{transform:rotate(0)}
  .se-faq details p{padding:0 40px 26px 0;color:#55534e}
  .se-wait{padding:clamp(70px,10vw,140px) 20px;background:var(--ink);color:var(--bone);text-align:center}
  .se-wait h2{font-size:clamp(2.6rem,6vw,5rem)}
  .se-wait>p{margin:18px auto 0;max-width:46ch;color:#cfc8bd}
  .se-form{display:flex;flex-wrap:wrap;justify-content:center;gap:12px;max-width:560px;margin:36px auto 0}
  .se-form input[type=email]{flex:1 1 260px;min-height:54px;padding:12px 16px;border:1px solid #f4f0ea66;background:transparent;color:var(--bone);font:inherit}
  .se-form input::placeholder{color:#b7b0a5}
  .se-form .se-btn{margin:0;background:var(--bone);color:var(--ink)!important;border-color:var(--bone)}
  .se-form .se-btn:hover{background:transparent;color:var(--bone)!important}
  .se-check{display:flex;align-items:center;gap:10px;flex-basis:100%;justify-content:center;font-size:14px;color:#cfc8bd}
  .se-check input{width:18px;height:18px;accent-color:var(--sage)}
  .se-msg{flex-basis:100%;min-height:1.6em;color:#d9e2d3}
  .se :is(.se-wait) :focus-visible{outline-color:var(--bone)}
  .se-foot{display:flex;flex-wrap:wrap;align-items:center;gap:16px 40px;padding:36px clamp(20px,6vw,90px);font-size:14px;color:#6e6a63}
  .se-foot img{height:34px;width:auto}
  .se-foot p:last-child{margin-left:auto}
  @media(max-width:820px){
    .se-head{gap:16px}.se-head nav{display:none}.se-link{margin-left:auto}
    .se-hero,.se-formula{grid-template-columns:1fr}
    .se-hero-img{border-radius:160px 160px 0 0}
    .se-steps{grid-template-columns:1fr;gap:48px}
    .se-skin blockquote{position:static;max-width:none;padding:28px 20px}
  }
  @media(prefers-reduced-motion:reduce){.se-btn,.se-faq summary span::before,.se-faq summary span::after{transition:none}}
</style>
