---
// Página temporal para comparar los diseños propuestos.
import Layout from '../layouts/Layout.astro';
const disenos = [
  { href: '/disenos/tablero', nombre: 'A · Tablero', desc: 'La estructura de tu imagen como tablero de mosaicos: estrenos, juegos, DLC y cierre.' },
  { href: '/disenos/poster', nombre: 'B · Póster', desc: 'Rojo a toda página, letra muy pesada y precios en grande, como un cartel.' },
  { href: '/disenos/codigos', nombre: 'C · Códigos', desc: 'Cada título es un boleto con talón perforado, como el código que vendes.' },
];
---
<Layout titulo="Elige un diseño">
  <main style="font-family:'Schibsted Grotesk',sans-serif;max-width:640px;margin:0 auto;padding:24px 16px;">
    <h1 style="font-size:40px;font-weight:800;letter-spacing:-.03em">Propuestas de diseño</h1>
    <p style="margin:8px 0 24px;font-size:17px">Precios de ejemplo. Toca varios juegos para probar el pedido.</p>
    {disenos.map((d) => (
      <a href={d.href} style="display:block;padding:20px;margin-bottom:8px;background:#efefF2;border-radius:8px">
        <strong style="font-size:22px">{d.nombre}</strong><p style="margin-top:4px;font-size:16px">{d.desc}</p>
      </a>
    ))}
  </main>
</Layout>
