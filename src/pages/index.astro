---
// Diseño A · Tablero (docs/diseno.md): mosaicos planos encajados borde a borde.
import Layout from '../layouts/Layout.astro';
import Mosaico from '../components/Mosaico.astro';
import Pedido from '../components/Pedido.astro';
import PanelVersiones from '../components/PanelVersiones.astro';
import Tema from '../components/Tema.astro';
import { tienda } from '../data/tienda';
import { destacados, secciones, whatsapp } from '../lib/catalogo';
import Buscador from '../components/Buscador.astro';
import Pie from '../components/Pie.astro';
import { Image } from 'astro:assets';
import logo from '../assets/marca/logo-sd-tech-imports.png';
import { anchoPieza, cierres, type Pieza } from '../lib/reticula';
const [principal, ...secundarios] = destacados;
// El mosaico "¿No ves...?" ocupa lo que falte para cerrar su sección sin huecos (ver lib/reticula.ts).
// Celular: 6 columnas, mosaicos de 3. Escritorio: 10 columnas, mosaicos de 2; destacados: el principal
// a todo el ancho (portada de cine) y los otros dos de 5, lado a lado.
// Un juego con versiones mide lo mismo que cualquier juego: las abre en un panel.
const piezas = (movil: boolean): Pieza[] => {
  const fila = { ancho: anchoPieza('fila', movil) };
  return [
    fila,
    ...(principal ? [{ ancho: anchoPieza('grande', movil) }] : []),
    ...secundarios.map(() => ({ ancho: anchoPieza('medio', movil) })),
    ...secciones.flatMap((s) => [
      ...(s.titulo ? [fila] : []),
      ...s.fichas.map(() => ({ ancho: anchoPieza('normal', movil) })),
      'cierre' as const,
    ]),
  ];
};
const movil = cierres(piezas(true), 6, 3);
const escritorio = cierres(piezas(false), 10, 2);
---
<Layout>
<!-- Antes del tablero: con el campo abierto, Tab pasa del campo a los resultados. -->
<Buscador />
<main class="tablero">
  <header class="cabecera">
    <div class="arriba">
      <!-- El logo maestro va sobre su placa blanca: sus letras navy no se leen sobre el suelo oscuro. -->
      <p class="marca"><Image src={logo} alt={tienda.nombre} width={290} height={110} loading="eager" /></p>
      <Tema />
    </div>
    <p class="ceja"><span>Códigos digitales · Nintendo Switch</span><span>{tienda.ciudad}</span></p>
    <h1>Códigos para <span class="acento">Switch 1 y 2</span><span class="punto">.</span></h1>
  </header>

  {principal && <Mosaico f={principal} tamano="grande" />}
  {secundarios.map((f) => <Mosaico f={f} tamano="medio" />)}

  {secciones.map((s, i) => (
    <>
      {s.titulo && <h2>{s.titulo}</h2>}
      {s.fichas.map((f) => <Mosaico f={f} />)}
      <a class="mas" href={whatsapp(s.mensaje)} target="_blank" rel="noopener" style={`--movil:${movil[i]};--escritorio:${escritorio[i]}`}>{s.mas}</a>
    </>
  ))}
</main>
<Pie />
<Pedido />
<PanelVersiones />
</Layout>

<style>
  .tablero { display: grid; grid-template-columns: repeat(6, 1fr); grid-auto-flow: dense; gap: 10px; padding: 10px; }
  .cabecera { grid-column: 1 / -1; padding: 18px 6px 22px; }
  /* Como el portafolio de SD Tech: logo arriba, una ceja en mono y el título en dos tonos,
     la segunda parte en el cian de la marca y un punto final en cian. */
  .arriba { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .marca { display: inline-flex; padding: 6px 12px; border-radius: 12px; background: #fff; }
  .marca img { display: block; width: auto; height: 40px; }
  .ceja {
    margin-top: 30px; padding-bottom: 12px; border-bottom: 1px solid var(--linea);
    display: flex; justify-content: space-between; gap: 12px;
    font-family: var(--mono); font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: var(--suave);
  }
  .ceja span:first-child::before { content: ''; display: inline-block; width: 18px; height: 2px; margin-right: 10px; vertical-align: middle; background: var(--acento); }
  h1 { margin-top: 22px; max-width: 12ch; font-size: clamp(36px, 10vw, 76px); font-weight: 800; line-height: 1; letter-spacing: -.045em; }
  .acento, .punto { color: var(--acento-texto); }
  /* En celular la ceja cabe en una línea solo sin la ciudad (va también en el pie). */
  .ceja span + span { display: none; }
  h2 { grid-column: 1 / -1; padding: 26px 4px 2px; font-size: clamp(26px, 6.4vw, 44px); font-weight: 800; letter-spacing: -.03em; line-height: 1; }
  .mas {
    grid-column: span var(--movil); min-height: 160px; border-radius: 12px; padding: 16px;
    display: flex; align-items: flex-end; background: var(--acento); color: var(--sobre-acento);
    font-size: 22px; font-weight: 800; line-height: 1.05; letter-spacing: -.02em;
  }
  /* Buscando (Buscador.astro): sin cabecera ni títulos; el campo fijo de arriba ocupa su lugar. */
  h2[hidden], .mas[hidden] { display: none; }
  .tablero[data-buscando] .cabecera { display: none; }
  :global(body:has(.tablero[data-buscando]) .pie-contacto) { display: none; }
  .tablero[data-buscando] { padding-top: 76px; }
  /* Tras usar el buscador, lo que reaparece (al filtrar o al cerrar) sube con un fundido corto.
     Solo desde entonces: al cargar la página los mosaicos salen quietos. */
  .tablero[data-filtrado] :global(.mosaico), .tablero[data-filtrado] .mas {
    transition: opacity .3s ease, translate .35s cubic-bezier(.34, 1.4, .64, 1), transform .15s, background-color .15s;
  }
  @starting-style {
    .tablero[data-filtrado] :global(.mosaico), .tablero[data-filtrado] .mas { opacity: 0; translate: 0 12px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .tablero[data-filtrado] :global(.mosaico), .tablero[data-filtrado] .mas { transition: none; }
  }

  @media (min-width: 760px) {
    /* Hasta 1440px: más ancho, los mosaicos se agrandan de más y las portadas pierden nitidez. */
    .tablero { grid-template-columns: repeat(10, 1fr); gap: 12px; padding: 12px; max-width: 1440px; margin: 0 auto; }
    /* Cabecera baja en escritorio: el título en 1 línea deja ver los 3 destacados con su precio sin desplazar. */
    .cabecera { padding: 22px 8px 26px; }
    h1 { margin-top: 18px; max-width: none; }
    .marca img { height: 48px; }
    .ceja { margin-top: 26px; }
    .ceja span + span { display: inline; }
    .mas { grid-column: span var(--escritorio); }
  }
</style>
