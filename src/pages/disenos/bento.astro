---
import Layout from '../../layouts/Layout.astro';
import Portada from '../../components/Portada.astro';
import { tienda } from '../../data/tienda';
import { estrenos, porTipo, precio, linkWhatsApp, etiquetaConsola } from '../../lib/catalogo';
const [principal, ...secundarios] = estrenos;
const juegos = porTipo('juego').filter((p) => !p.estreno);
const extras = [...porTipo('dlc'), ...porTipo('update')];
---
<Layout titulo={`${tienda.nombre} · Catálogo`}>
<main class="bento">
  <header class="cab">
    <div class="logo" aria-hidden="true"><span></span><span></span></div>
    <div>
      <p class="tienda">{tienda.nombre}</p>
      <h1>{tienda.eslogan}</h1>
      <p class="pill">Nintendo Switch 1 y 2</p>
    </div>
  </header>

  <h2 class="sec"><span class="tag">★ Estrenos</span></h2>
  <section class="estrenos">
    {principal && (
      <a class="tile big" href={linkWhatsApp(principal)}>
        <Portada p={principal} grande />
        <span class="nuevo">Nuevo</span>
        <span class="precio">{precio(principal.precio)}</span>
      </a>
    )}
    {secundarios.map((p) => (
      <a class="tile" href={linkWhatsApp(p)}>
        <Portada p={p} />
        <span class="nuevo">Nuevo</span>
        <span class="precio">{precio(p.precio)}</span>
      </a>
    ))}
  </section>

  <h2 class="sec"><span class="dot"></span>Juegos disponibles</h2>
  <section class="grid">
    {juegos.map((p) => (
      <a class="tile" href={linkWhatsApp(p)} title={`${p.nombre} · ${etiquetaConsola(p.consolas)}`}>
        <Portada p={p} />
        {p.consolas.length === 1 && <span class="ns2">NS2</span>}
        <span class="precio">{precio(p.precio)}</span>
      </a>
    ))}
  </section>

  <h2 class="sec"><span class="dot"></span>DLC y updates</h2>
  <section class="grid">
    {extras.map((p) => (
      <a class="tile" href={linkWhatsApp(p)} title={p.nombre}>
        <Portada p={p} />
        <span class="ns2">{p.tipo === 'dlc' ? 'DLC' : 'UPD'}</span>
        <span class="precio">{precio(p.precio)}</span>
      </a>
    ))}
  </section>

  <footer class="pie">
    <ul>{tienda.beneficios.map((b) => <li>✓ {b}</li>)}</ul>
    <a class="cta" href={linkWhatsApp()}>Pedir por WhatsApp</a>
  </footer>
</main>
</Layout>

<style>
  .bento { --rojo: #e60012; max-width: 960px; margin: 0 auto; padding: 16px; background: linear-gradient(#fff, #fdeeee); min-height: 100vh; color: #1a1a1a; }
  .cab { display: flex; gap: 14px; align-items: center; margin-bottom: 18px; }
  .logo { flex: none; width: 64px; height: 64px; border-radius: 14px; background: var(--rojo); display: flex; gap: 4px; align-items: center; justify-content: center; }
  .logo span { width: 14px; height: 30px; border: 3px solid #fff; border-radius: 8px 3px 3px 8px; }
  .logo span:last-child { border-radius: 3px 8px 8px 3px; background: #fff; }
  .tienda { margin: 0; font-size: .75rem; font-weight: 600; color: #777; text-transform: uppercase; letter-spacing: .08em; }
  h1 { margin: 2px 0 6px; font-size: clamp(1.05rem, 4.5vw, 1.8rem); font-weight: 900; text-transform: uppercase; line-height: 1.1; }
  .pill { display: inline-block; margin: 0; background: var(--rojo); color: #fff; font-weight: 800; font-size: .75rem; letter-spacing: .06em; padding: 5px 14px; border-radius: 99px; text-transform: uppercase; }
  .sec { display: flex; align-items: center; gap: 8px; margin: 22px 0 10px; font-size: .85rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: #333; }
  .sec::after { content: ''; flex: 1; height: 1px; background: #e2cfcf; }
  .tag { background: var(--rojo); color: #fff; padding: 4px 14px; border-radius: 99px; }
  .dot { width: 10px; height: 10px; border-radius: 50%; background: var(--rojo); }
  .estrenos { display: grid; grid-template-columns: 2fr 1fr; grid-auto-rows: minmax(90px, 1fr); gap: 8px; }
  .estrenos .big { grid-row: span 2; aspect-ratio: auto; }
  .tile { position: relative; display: block; border-radius: 10px; overflow: hidden; aspect-ratio: 16 / 10; box-shadow: 0 2px 8px rgb(0 0 0 / .12); transition: transform .15s; }
  .tile:active { transform: scale(.97); }
  .nuevo, .ns2 { position: absolute; top: 6px; left: 6px; background: var(--rojo); color: #fff; font-size: .6rem; font-weight: 800; padding: 2px 8px; border-radius: 99px; text-transform: uppercase; }
  .ns2 { left: auto; right: 6px; background: #111; }
  .precio { position: absolute; right: 6px; bottom: 6px; background: #fff; color: var(--rojo); font-weight: 900; font-size: .75rem; padding: 3px 8px; border-radius: 6px; box-shadow: 0 1px 4px rgb(0 0 0 / .25); }
  .big .precio { font-size: 1.1rem; padding: 6px 12px; }
  .big .nuevo { font-size: .8rem; padding: 4px 12px; top: 10px; left: 10px; }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
  @media (min-width: 640px) { .grid { grid-template-columns: repeat(5, 1fr); } }
  .pie { margin-top: 24px; background: #fff; border-radius: 14px; padding: 14px; display: flex; flex-wrap: wrap; gap: 12px; align-items: center; justify-content: space-between; box-shadow: 0 2px 10px rgb(0 0 0 / .06); }
  .pie ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 4px 14px; font-size: .8rem; font-weight: 600; color: #444; }
  .pie li::first-letter { color: #1a9c4a; }
  .cta { background: var(--rojo); color: #fff; font-weight: 800; padding: 12px 20px; border-radius: 99px; text-transform: uppercase; font-size: .85rem; flex: 1 1 auto; text-align: center; }
</style>
